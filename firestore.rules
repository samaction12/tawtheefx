rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function okStr(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // Public catalog data
    match /jobs/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /site_settings/{d=**} { allow read: if true; allow write: if false; } // written by server only

    // Candidates may submit an application, nobody but admins can read/change it
    match /applications/{id} {
      allow create: if okStr(request.resource.data.name, 100) && okStr(request.resource.data.email, 120)
                    && request.resource.data.status in ['جديد', 'مؤهل للمقابلة'] && request.resource.data.keys().size() < 25;
      allow read, update, delete: if isAdmin();
    }
    match /support_tickets/{id} {
      allow create: if okStr(request.resource.data.message, 1000);
      allow read, update, delete: if isAdmin();
    }

    // Money, settings, audit: server (Admin SDK bypasses rules) or admin only
    match /orders/{id}            { allow read: if isAdmin(); allow write: if false; }
    match /invoices/{id}          { allow read: if isAdmin(); allow write: if false; }
    match /counters/{id}          { allow read, write: if false; }
    match /audit_logs/{id}        { allow read: if isAdmin(); allow write: if false; }
    match /owner_settings/{id}    { allow read, write: if isAdmin(); }
    match /marketing_campaigns/{id} { allow read, write: if isAdmin(); }
    match /reminders/{id}         { allow read, write: if isAdmin(); }
    match /payouts/{id}           { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
